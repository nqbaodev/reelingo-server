NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Set both credentials to enable /logger. They are loaded at startup and are not
# stored in PostgreSQL. Username: 1-128 characters, no colon. Password: 16-1024.
# ADMIN_LOGGER_USERNAME=admin
# ADMIN_LOGGER_PASSWORD=replace-with-a-long-random-password
ADMIN_LOGGER_MAX_ENTRIES=1000
CORS_ORIGIN=*
PUBLIC_BASE_URL=http://localhost:3000
STORAGE_ROOT=storage

DATABASE_URL="postgresql://reelingo:reelingo@localhost:5432/reelingo_dev?schema=public"
DATABASE_CONNECT_TIMEOUT_MS=3000
DATABASE_QUERY_TIMEOUT_MS=5000

GOOGLE_CLIENT_ID=""
GEMINI_API_KEY=""
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=30000
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_VIDEO_MODEL=veo-3.1-fast-generate-preview
# Configure both values to route chat decisions through the standalone ./reelingo-ai
# service. Use a separate random token rather than JWT_SECRET.
# AI_AGENT_SERVICE_URL=http://127.0.0.1:4100
# AI_AGENT_SERVICE_TOKEN=replace-with-an-independent-random-string-of-at-least-32-chars
AI_AGENT_SERVICE_TIMEOUT_MS=45000
AI_GENERATION_WORKER_ENABLED=false
AI_GENERATION_POLL_INTERVAL_MS=1000
AI_GENERATION_LEASE_MS=60000
AI_GENERATION_TIMEOUT_MS=600000
AI_VIDEO_POLL_INTERVAL_MS=2000
JWT_SECRET="change-me-to-a-random-string-of-at-least-32-chars"
JWT_ISSUER=reelingo-server
JWT_AUDIENCE=reelingo-api
ACCESS_TOKEN_TTL_MINUTES=15
SESSION_TTL_MINUTES=10080

AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_SECONDS=60
API_RATE_LIMIT=100
API_RATE_WINDOW_SECONDS=60
