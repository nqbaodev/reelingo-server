{
  "name": "reelingo-ai",
  "version": "0.1.0",
  "description": "Standalone Reelingo AI agent service",
  "private": true,
  "type": "commonjs",
  "main": "dist/apps/api/src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch apps/api/src/server.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/apps/api/src/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint",
    "verify": "npm run check && npm run build"
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "tsx": "^4.23.13",
    "tsc-alias": "^1.9.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
